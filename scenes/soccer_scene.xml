<?xml version="1.0" encoding="utf-8"?>
<!--
  soccer_scene.xml — 3v3: campo + bola + 6 robôs T1
  Time 1 (cinza, olhando +x): robots 1, 3, 5  (x negativo)
  Time 2 (vermelho, olhando -x): robots 2, 4, 6  (x positivo)
  Referência de coords: x = direção do ataque (gol direito em x=+7)
                        y = lateral esquerda positiva
                        z = cima
-->
<mujoco model="t1_soccer_sim">

  <compiler angle="radian" meshdir="../assets/meshes/" autolimits="true"/>

  <option gravity="0 0 -9.81" timestep="0.005"/>

  <!-- ═══════════════════════════════════════════════════════ ASSETS -->
  <asset>
    <include file="../assets/field_assets.xml"/>
    <include file="../assets/ball_assets.xml"/>
    <include file="../assets/robot_mesh_assets.xml"/>
  </asset>

  <!-- ══════════════════════════════════════════════════════ WORLDBODY -->
  <worldbody>

    <!-- ── Iluminação ── -->
    <light directional="true" diffuse=".5 .5 .5" specular="0.1 0.1 0.1"
           pos="0 0 8" dir="0 0 -1" castshadow="false"/>
    <light directional="true" diffuse=".6 .6 .6" specular="0.2 0.2 0.2"
           pos="0 0 6" dir="0 0 -1"/>

    <include file="../assets/field_body.xml"/>
    <include file="../assets/ball_body.xml"/>

    <!-- Time 1 (cinza) -->
    <include file="../assets/robot1/robot1_body.xml"/>
    <include file="../assets/robot3/robot3_body.xml"/>
    <include file="../assets/robot5/robot5_body.xml"/>

    <!-- Time 2 (vermelho) -->
    <include file="../assets/robot2/robot2_body.xml"/>
    <include file="../assets/robot4/robot4_body.xml"/>
    <include file="../assets/robot6/robot6_body.xml"/>

  </worldbody>

  <!-- ══════════════════════════════════════════════════════ ATUADORES -->
  <actuator>
    <include file="../assets/robot1/robot1_actuators.xml"/>
    <include file="../assets/robot3/robot3_actuators.xml"/>
    <include file="../assets/robot5/robot5_actuators.xml"/>
    <include file="../assets/robot2/robot2_actuators.xml"/>
    <include file="../assets/robot4/robot4_actuators.xml"/>
    <include file="../assets/robot6/robot6_actuators.xml"/>
  </actuator>

  <!-- ══════════════════════════════════════════════════════ SENSORES -->
  <sensor>
    <framequat name="orientation"          objtype="site" objname="imu"   noise="0.001"/>
    <gyro      name="angular-velocity"     site="imu"                     noise="0.005"/>
    <framequat name="orientation_3"        objtype="site" objname="imu_3" noise="0.001"/>
    <gyro      name="angular-velocity_3"   site="imu_3"                   noise="0.005"/>
    <framequat name="orientation_5"        objtype="site" objname="imu_5" noise="0.001"/>
    <gyro      name="angular-velocity_5"   site="imu_5"                   noise="0.005"/>
    <framequat name="orientation_2"        objtype="site" objname="imu_2" noise="0.001"/>
    <gyro      name="angular-velocity_2"   site="imu_2"                   noise="0.005"/>
    <framequat name="orientation_4"        objtype="site" objname="imu_4" noise="0.001"/>
    <gyro      name="angular-velocity_4"   site="imu_4"                   noise="0.005"/>
    <framequat name="orientation_6"        objtype="site" objname="imu_6" noise="0.001"/>
    <gyro      name="angular-velocity_6"   site="imu_6"                   noise="0.005"/>
  </sensor>

  <!-- ══════════════════════════════════════════════════════ KEYFRAME
       Ordem dos robôs em qpos/ctrl: 1, 3, 5, 2, 4, 6  (mesma ordem dos <include>s)
       qpos = ball(7) | r1(30) | r3(30) | r5(30) | r2(30) | r4(30) | r6(30)
       ctrl = r1(23)  | r3(23) | r5(23) | r2(23) | r4(23) | r6(23)
       Pose home por robô (23 joints):
         head(2): 0 0
         Larm(4): 0.2 -1.3 0 -0.5
         Rarm(4): 0.2  1.3 0  0.5
         waist(1): 0
         Lleg(6): -0.2 0 0 0.4 -0.2 0
         Rleg(6): -0.2 0 0 0.4 -0.2 0                       -->
  <keyframe>
    <key name="home"
         qpos="0 0 0.11 1 0 0 0
               -1  0.0 0.679 1 0 0 0  0 0  0.2 -1.3 0 -0.5  0.2  1.3 0  0.5  0  -0.2 0 0 0.4 -0.2 0  -0.2 0 0 0.4 -0.2 0
               -2  1.5 0.679 1 0 0 0  0 0  0.2 -1.3 0 -0.5  0.2  1.3 0  0.5  0  -0.2 0 0 0.4 -0.2 0  -0.2 0 0 0.4 -0.2 0
               -2 -1.5 0.679 1 0 0 0  0 0  0.2 -1.3 0 -0.5  0.2  1.3 0  0.5  0  -0.2 0 0 0.4 -0.2 0  -0.2 0 0 0.4 -0.2 0
                1  0.0 0.679 0 0 0 1  0 0  0.2 -1.3 0 -0.5  0.2  1.3 0  0.5  0  -0.2 0 0 0.4 -0.2 0  -0.2 0 0 0.4 -0.2 0
                2  1.5 0.679 0 0 0 1  0 0  0.2 -1.3 0 -0.5  0.2  1.3 0  0.5  0  -0.2 0 0 0.4 -0.2 0  -0.2 0 0 0.4 -0.2 0
                2 -1.5 0.679 0 0 0 1  0 0  0.2 -1.3 0 -0.5  0.2  1.3 0  0.5  0  -0.2 0 0 0.4 -0.2 0  -0.2 0 0 0.4 -0.2 0"
         ctrl="0 0  0.2 -1.3 0 -0.5  0.2  1.3 0  0.5  0  -0.2 0 0 0.4 -0.2 0  -0.2 0 0 0.4 -0.2 0
               0 0  0.2 -1.3 0 -0.5  0.2  1.3 0  0.5  0  -0.2 0 0 0.4 -0.2 0  -0.2 0 0 0.4 -0.2 0
               0 0  0.2 -1.3 0 -0.5  0.2  1.3 0  0.5  0  -0.2 0 0 0.4 -0.2 0  -0.2 0 0 0.4 -0.2 0
               0 0  0.2 -1.3 0 -0.5  0.2  1.3 0  0.5  0  -0.2 0 0 0.4 -0.2 0  -0.2 0 0 0.4 -0.2 0
               0 0  0.2 -1.3 0 -0.5  0.2  1.3 0  0.5  0  -0.2 0 0 0.4 -0.2 0  -0.2 0 0 0.4 -0.2 0
               0 0  0.2 -1.3 0 -0.5  0.2  1.3 0  0.5  0  -0.2 0 0 0.4 -0.2 0  -0.2 0 0 0.4 -0.2 0"/>
  </keyframe>

</mujoco>
