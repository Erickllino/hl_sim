 void RobotClient::init(string robot_name)
 {
+    kickPublisher = brain->create_publisher<std_msgs::msg::Bool>("kick_intent", 10);
     string suffix = robot_name.empty() ? "" : ("/" + robot_name);
     publisher = brain->create_publisher<booster_msgs::msg::RpcReqMsg>("LocoApiTopic" + suffix + "Req", 10);
+}
+
+// Publishes intent only; consumers decide how to execute the normal kick.
+void RobotClient::setKickActive(bool active)
+{
+    std_msgs::msg::Bool msg;
+    msg.data = active;
+    kickPublisher->publish(msg);
 }
 
