<worldbody>
  <!-- campo: 14 m × 9 m (half-extents 7 × 4.5) -->
  <geom name="field" type="plane" size="7.0 4.5 0.1" material="field_mat"/>

  <!-- linhas laterais e de fundo -->
  <geom type="box" pos="0  4.5 0.001" size="7.0 0.02 0.001" material="line_mat"
        contype="0" conaffinity="0"/>
  <geom type="box" pos="0 -4.5 0.001" size="7.0 0.02 0.001" material="line_mat"
        contype="0" conaffinity="0"/>
  <geom type="box" pos=" 7.0 0 0.001" size="0.02 4.5 0.001" material="line_mat"
        contype="0" conaffinity="0"/>
  <geom type="box" pos="-7.0 0 0.001" size="0.02 4.5 0.001" material="line_mat"
        contype="0" conaffinity="0"/>

  <!-- linha do meio-campo -->
  <geom type="box" pos="0 0 0.001" size="0.02 4.5 0.001" material="line_mat"
        contype="0" conaffinity="0"/>
  <!-- círculo central -->
  <geom type="cylinder" pos="0 0 0.001" size="1.5 0.001" material="line_mat"
        contype="0" conaffinity="0"/>

  <!-- ponto de pênalti direito/esquerdo -->
  <geom type="sphere" pos=" 5.9 0 0.01" size="0.05" material="line_mat"
        contype="0" conaffinity="0"/>
  <geom type="sphere" pos="-5.9 0 0.01" size="0.05" material="line_mat"
        contype="0" conaffinity="0"/>

  <!-- área de gol -->
  <geom type="box" pos=" 6.0 0 0.001" size="1.0 2.0 0.001" material="line_mat"
        contype="0" conaffinity="0"/>
  <geom type="box" pos="-6.0 0 0.001" size="1.0 2.0 0.001" material="line_mat"
        contype="0" conaffinity="0"/>

  <!-- gol direito (x = +7) -->
  <body name="goal_right" pos="7.0 0 0">
    <geom type="cylinder" fromto="0  1.3 0 0  1.3 1.8" size="0.05" material="goal_mat"/>
    <geom type="cylinder" fromto="0 -1.3 0 0 -1.3 1.8" size="0.05" material="goal_mat"/>
    <geom type="cylinder" fromto="0  1.3 1.8 0 -1.3 1.8" size="0.05" material="goal_mat"/>
    <geom type="box" pos="0.3 0 0.001" size="0.3 1.3 0.001" material="line_mat"
          contype="0" conaffinity="0"/>
  </body>

  <!-- gol esquerdo (x = -7) -->
  <body name="goal_left" pos="-7.0 0 0">
    <geom type="cylinder" fromto="0  1.3 0 0  1.3 1.8" size="0.05" material="goal_mat"/>
    <geom type="cylinder" fromto="0 -1.3 0 0 -1.3 1.8" size="0.05" material="goal_mat"/>
    <geom type="cylinder" fromto="0  1.3 1.8 0 -1.3 1.8" size="0.05" material="goal_mat"/>
    <geom type="box" pos="-0.3 0 0.001" size="0.3 1.3 0.001" material="line_mat"
          contype="0" conaffinity="0"/>
  </body>
</worldbody>
