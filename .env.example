# BuildKit clona robocin/hsl-player@main (antiga main26), via SSH por padrão.
# Deixe vazio para usar GitHub. Para editar o brain, indique um clone local
# atualizado da main (caminho absoluto ou relativo a docker/).
HSL_PLAYER_DIR=

# Metadado opcional para builds com clone local.
# HSL_COMMIT=68e1b79
HL_BRAINS=all
LOG=INFO
